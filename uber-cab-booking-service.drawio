  <diagram name="Page-1" id="V8NN63kaTcK6JpyfRdXf">
    <mxGraphModel dx="2754" dy="1703" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="zgzDocX5lwGxHwXeEKCY-4" connectable="0" parent="1" style="group" value="" vertex="1">
          <mxGeometry height="360" width="430" x="70" y="480" as="geometry" />
        </mxCell>
        <mxCell id="zgzDocX5lwGxHwXeEKCY-1" parent="zgzDocX5lwGxHwXeEKCY-4" style="rounded=1;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="360" width="430" as="geometry" />
        </mxCell>
        <mxCell id="zgzDocX5lwGxHwXeEKCY-2" parent="zgzDocX5lwGxHwXeEKCY-4" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Functional requirements&lt;/font&gt;&lt;/h1&gt;&lt;blockquote style=&quot;margin: 0 0 0 40px; border: none; padding: 0px;&quot;&gt;&lt;li&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;A rider can enter pickup and drop-off locations.&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;A rider can request a ride.&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;The system identifies and notifies nearby available drivers.&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;A driver can accept or reject a ride request.&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;The system assigns the ride to one driver only.&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;The rider receives an OTP after driver assignment; the driver verifies it to start the trip.&lt;/font&gt;&lt;/li&gt;&lt;/blockquote&gt;" vertex="1">
          <mxGeometry height="180" width="390" x="20" y="10" as="geometry" />
        </mxCell>
        <mxCell id="zgzDocX5lwGxHwXeEKCY-3" parent="zgzDocX5lwGxHwXeEKCY-4" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Non-functional requirements&lt;/font&gt;&lt;/span&gt;&lt;/h1&gt;&lt;blockquote style=&quot;margin: 0px 0px 0px 40px; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; padding: 0px;&quot;&gt;&lt;div&gt;&lt;li&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;&lt;font style=&quot;&quot;&gt;H&lt;/font&gt;&lt;font style=&quot;&quot;&gt;igh availability: users should be able to request and accept rides even during failures.&lt;/font&gt;&lt;/font&gt;&lt;/li&gt;&lt;/div&gt;&lt;div&gt;&lt;li&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Low latency: matching and driver notifications should happen within a few seconds.&lt;/font&gt;&lt;/li&gt;&lt;/div&gt;&lt;div&gt;&lt;li&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Eventual consistency for live location: a small delay in a driver’s displayed location is acceptable.&lt;/font&gt;&lt;/li&gt;&lt;/div&gt;&lt;div&gt;&lt;li&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Reliability: prevent duplicate ride assignments and handle retries safely.&lt;/font&gt;&lt;/li&gt;&lt;/div&gt;&lt;div&gt;&lt;li&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;Scalability: support large volumes of ride requests and frequent driver-location updates.&lt;/font&gt;&lt;/li&gt;&lt;/div&gt;&lt;/blockquote&gt;" vertex="1">
          <mxGeometry height="180" width="390" x="10" y="151" as="geometry" />
        </mxCell>
        <mxCell id="zgzDocX5lwGxHwXeEKCY-5" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;" value="&lt;font style=&quot;font-size: 21px;&quot;&gt;Design - Cab Boooking Service (Uber)&lt;/font&gt;" vertex="1">
          <mxGeometry height="60" width="300" x="250" y="30" as="geometry" />
        </mxCell>
        <mxCell id="PgYEmlTDX6lSRHRrRK8N-6" connectable="0" parent="1" style="group" value="" vertex="1">
          <mxGeometry height="280" width="200" x="550" y="120" as="geometry" />
        </mxCell>
        <mxCell id="PgYEmlTDX6lSRHRrRK8N-1" parent="PgYEmlTDX6lSRHRrRK8N-6" style="rounded=1;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="280" width="200" as="geometry" />
        </mxCell>
        <mxCell id="PgYEmlTDX6lSRHRrRK8N-2" parent="PgYEmlTDX6lSRHRrRK8N-6" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Core Entities&lt;/h1&gt;&lt;p&gt;Rider&lt;/p&gt;&lt;p&gt;Driver&lt;/p&gt;&lt;p&gt;Vehicle&lt;/p&gt;&lt;p&gt;Ride&lt;/p&gt;&lt;p&gt;Location&lt;/p&gt;&lt;p&gt;Payment&lt;/p&gt;&lt;p&gt;Notification&lt;/p&gt;&lt;p&gt;&lt;br&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="223.80952380952382" width="179.99999999999997" x="10" y="28.09047619047619" as="geometry" />
        </mxCell>
        <mxCell id="PgYEmlTDX6lSRHRrRK8N-7" connectable="0" parent="1" style="group" value="" vertex="1">
          <mxGeometry height="200" width="490" x="70" y="880" as="geometry" />
        </mxCell>
        <mxCell id="PgYEmlTDX6lSRHRrRK8N-3" parent="PgYEmlTDX6lSRHRrRK8N-7" style="rounded=1;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="200" width="490" as="geometry" />
        </mxCell>
        <mxCell id="PgYEmlTDX6lSRHRrRK8N-4" parent="PgYEmlTDX6lSRHRrRK8N-7" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;API - Endpoints&lt;/h1&gt;&lt;p&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(179, 255, 102), rgb(102, 255, 102));&quot;&gt;&lt;font&gt;POST /rides&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;Create ride request: pickup, dropoff, vehicleType&lt;/font&gt;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;color: light-dark(rgb(179, 255, 102), rgb(102, 255, 102));&quot;&gt;POST /rides/{id}/accept&amp;nbsp; &amp;nbsp; &amp;nbsp;Driver accepts a request&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;color: light-dark(rgb(179, 255, 102), rgb(102, 255, 102));&quot;&gt;POST /rides/{id}/start&amp;nbsp; &amp;nbsp; &amp;nbsp; Verify rider OTP and start the ride&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;color: light-dark(rgb(179, 255, 102), rgb(102, 255, 102));&quot;&gt;POST /rides/{id}/complete&amp;nbsp; &amp;nbsp;Complete the ride&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;color: light-dark(rgb(179, 255, 102), rgb(102, 255, 102));&quot;&gt;PATCH /drivers/me/location&amp;nbsp; Send driver’s current latitude/longitude&lt;/font&gt;&lt;/li&gt;&lt;li&gt;&lt;font style=&quot;color: light-dark(rgb(179, 255, 102), rgb(102, 255, 102));&quot;&gt;GET /rides/{id}&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;Get ride status and tracking data&lt;/font&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;/p&gt;&lt;p&gt;&amp;nbsp;&lt;/p&gt;" vertex="1">
          <mxGeometry height="150" width="460" x="15" y="25" as="geometry" />
        </mxCell>
        <mxCell id="PgYEmlTDX6lSRHRrRK8N-10" connectable="0" parent="1" style="group" value="" vertex="1">
          <mxGeometry height="260" width="400" x="70" y="155" as="geometry" />
        </mxCell>
        <mxCell id="PgYEmlTDX6lSRHRrRK8N-9" parent="PgYEmlTDX6lSRHRrRK8N-10" style="rounded=1;whiteSpace=wrap;html=1;" value="" vertex="1">
          <mxGeometry height="260" width="400" as="geometry" />
        </mxCell>
        <mxCell id="PgYEmlTDX6lSRHRrRK8N-8" parent="PgYEmlTDX6lSRHRrRK8N-10" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(255, 51, 51));&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;Workflow&lt;/span&gt;&lt;/h1&gt;&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(51, 255, 51)); background-color: transparent; font-size: 12px; font-weight: normal;&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; Rider requests ride&lt;/span&gt;&lt;/h1&gt;&lt;p&gt;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(51, 255, 51));&quot;&gt;matching service finds nearby drivers&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(51, 255, 51));&quot;&gt;one driver accepts&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(51, 255, 51));&quot;&gt;ystem assigns driver and generates OTP&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(51, 255, 51));&quot;&gt;rider shares OTP at pickup&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(51, 255, 51));&quot;&gt;driver verifies OTP and starts ride&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(51, 255, 51));&quot;&gt;live location is updated during the trip&lt;/span&gt;&lt;/li&gt;&lt;li&gt;&lt;span style=&quot;color: light-dark(rgb(0, 0, 0), rgb(51, 255, 51));&quot;&gt;driver completes ride&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;/p&gt;" vertex="1">
          <mxGeometry height="195" width="360" x="20" y="22.5" as="geometry" />
